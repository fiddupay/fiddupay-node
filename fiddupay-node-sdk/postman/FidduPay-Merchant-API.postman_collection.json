      "description": "Local sandbox server"
    },
    {
      "key": "productionUrl",
      "value": "https://api.fiddupay.com",
      "type": "string",
      "description": "Production server"
    },
    {
      "key": "apiKey",
      "value": "sandbox_test_key_12345",
      "type": "string",
      "description": "Merchant API key"
    }
