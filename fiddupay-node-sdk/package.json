{
  "name": "@fiddupay/node-sdk",
  "version": "2.6.20",
  "description": "FidduPay payment gateway Node.js SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run build && npm test",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fiddupay",
    "cryptocurrency",
    "payments",
    "blockchain",
    "bitcoin",
    "ethereum",
    "solana",
    "usdt",
    "fintech",
    "api"
  ],
  "author": "TechyTro Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fiddupay/fiddupay-node.git"
  },
  "bugs": {
    "url": "https://github.com/fiddupay/fiddupay-node/issues"
  },
  "homepage": "https://github.com/fiddupay/fiddupay-node#readme",
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "express": "^4.22.1",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "follow-redirects": "^1.16.0",
    "handlebars": "^4.7.9",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
