{
	# Global options
	email techytrosoftware@gmail.com
}

# Frontend (React/Vite SPA)
fiddupay.com, www.fiddupay.com {
	root * /home/vibes/crypto-payment-gateway/frontend/dist
	encode gzip
	file_server

	# Proxy payment links to the backend
	handle /pay/* {
		reverse_proxy localhost:8080
	}

	# SPA Routing: If file doesn't exist, serve index.html
	handle {
		try_files {path} /index.html
	}

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-XSS-Protection "1; mode=block"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/fiddupay.frontend.log
	}
}

# Backend API
api.fiddupay.com {
	reverse_proxy localhost:8080 {
		header_up Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000;"
	}

	log {
		output file /var/log/caddy/fiddupay.api.log
	}
}
