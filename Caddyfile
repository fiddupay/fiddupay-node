{
    # Global options
    email techytrosoftware@gmail.com
}

fiddupay.com, www.fiddupay.com, api.fiddupay.com {
    # Proxy all requests to the Rust backend
    reverse_proxy localhost:8080 {
        header_up Host {host}
    }

    # Enable compression
    encode gzip

    # Security headers (Let Rust handle CORS)
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output file /var/log/caddy/fiddupay.access.log
    }
}
