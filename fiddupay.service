[Unit]
Description=FidduPay Cryptocurrency Payment Gateway
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=vibes
WorkingDirectory=/home/vibes/apps/current/backend
Environment="RUST_LOG=info"
EnvironmentFile=/home/vibes/apps/.env.production
ExecStart=/home/vibes/apps/current/backend/target/release/fiddupay
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
